PORT=4000

# Local Docker defaults. DATABASE_URL takes precedence on hosted deployments.
DB_HOST=localhost
DB_PORT=5433
DB_USER=macrodesk
DB_PASSWORD=devroot
DB_NAME=macrodesk
# DATABASE_URL=

# Remote database connections use verified TLS by default.
# DB_SSL=true
# DB_CA=certificate with newlines escaped as \n
# Render's private database endpoint uses a self-signed certificate.
# Set this only for that private connection; keep verification for public hosts.
# DB_SSL_REJECT_UNAUTHORIZED=false

FMP_API_KEY=
FRED_API_KEY=

# Optional ranking; the brief falls back to newest facts without this.
OPEN_AI_KEY=
# OPENAI_MODEL=gpt-5-nano
# OPENAI_MAX_CALLS_PER_HOUR=60

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
AUTH_PROVIDER=local

# Required in production. Use the browser-facing frontend origin.
ALLOWED_ORIGINS=http://localhost:3000

# Secure cookies default on in production; HTTPS is required.
# COOKIE_SECURE=true

# Match the actual proxy chain. Render defaults to one trusted hop.
# TRUST_PROXY=1
