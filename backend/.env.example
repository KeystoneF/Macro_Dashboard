PORT=4000

# Local docker sets the parts. Render hands the whole connection over as one
# DATABASE_URL, which wins over these when it is set.
DB_HOST=localhost
# 5433, the host port docker-compose.yml publishes, not the container 5432
DB_PORT=5433
DB_USER=macrodesk
DB_PASSWORD=change-me
DB_NAME=macrodesk
# DATABASE_URL=

# TLS to the database. Unset follows the url: on for a managed host, off for
# local docker, which speaks no TLS and refuses the connection outright.
# DB_SSL=true

FMP_API_KEY=
FRED_API_KEY=

# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
AUTH_PROVIDER=local

# Origins allowed to call this API with a session cookie, comma separated.
ALLOWED_ORIGINS=http://localhost:3000

# Secure cookies need TLS: a browser will not store one sent over plain http,
# which looks like sign-in silently failing. Leave unset to follow NODE_ENV,
# or set false deliberately when serving production over http.
# COOKIE_SECURE=true
